---
/**
 * The product page for the Toddle Enhancement Extension.
 *
 * Written for two readers who arrive with different questions: a teacher who
 * wants to know what it does and how to get it, and an IT lead who wants to
 * know what it can see before putting it on a hundred machines. The flag
 * switch gets the most room because it is the part people will be asked to
 * justify.
 *
 * It describes version 0.12.0 (`extensionVersions.current`), on the Chrome
 * Web Store: the Excel export, claim links instead of keys in licence emails,
 * a school's licence set through Chrome policy, and the Toddle compatibility
 * check. It names 0.8.2 only where updating from it matters, and 0.9.0
 * (`extensionVersions.changedIn`) only for the old licence host.
 * Flags are "concealed", never "hidden": the extension no longer hides
 * Toddle's own flags (see `flags` in src/data/legal.ts).
 */
import { Picture } from "astro:assets";
import type { ImageOutputFormat } from "astro";
import Hero from "@bundu/ui/Hero.astro";
import Section from "@bundu/ui/Section.astro";
import SectionHeader from "@bundu/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import DataFlow from "../components/DataFlow.astro";
import FactStrip from "../components/FactStrip.astro";
import TrustPoints from "../components/TrustPoints.astro";
import ExtensionPricing from "../components/ExtensionPricing.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { toddleExtension } from "../data/site";
import {
  extensionVersions,
  flags,
  ownership,
  licenceSync,
  upgrade,
  refunds,
  toddleNotice,
} from "../data/legal";
import gradebookShot from "../assets/screenshots/01-gradebook.jpg";
import sidebarShot from "../assets/screenshots/02-student-sidebar.jpg";
import todayShot from "../assets/screenshots/03-today.jpg";
import licenceShot from "../assets/screenshots/04-licence.jpg";
import myClassesShot from "../assets/screenshots/05-my-classes.jpg";
import flagsShot from "../assets/screenshots/06-flags.jpg";
import menuShot from "../assets/screenshots/07-menu.jpg";
import feedbackShot from "../assets/screenshots/08-feedback.jpg";
import welcomeShot from "../assets/screenshots/09-welcome.jpg";

/* One switch drives every call to action on this page. While there is no store
   listing the page says so and offers to take an enquiry; the moment
   `webStore` is set it becomes an install page, with no other edit. The source
   repository is private, so nothing here links to it.

   Distribution is the Chrome Web Store and only the Chrome Web Store — there is
   no download, no .zip and no Developer mode anywhere in this copy. That is a
   deliberate constraint, not an omission: "unzip this and turn on Developer
   mode" is where a teacher gives up, and a school's IT will not push a
   self-hosted package when a store ID will do. */
const live = Boolean(toddleExtension.webStore);
const primaryCta = live
  ? { label: "Add to Chrome", href: toddleExtension.webStore! }
  : { label: "Tell me when it is live", href: toddleExtension.enquiry };

/* `free` is the split the extension enforces (its docs/licensing.md and
   app/features/registry.ts): the flag switch and My classes for everyone, the
   rest with a licence. Keep it in step with `pricing` in src/data/legal.ts,
   the terms, and the licence email (nyuchi-licence-server, src/email.js). */
const features = [
  {
    mineral: "cobalt",
    free: false,
    title: "Per-criterion columns",
    body: "Toddle shows an assessment tool as one icon per student, and you open a side panel to read each one. This puts one column per standard, criterion or checklist item on the grid, with every student's result visible at once and the full wording on hover — one tool at a time, or all of an assessment's tools together.",
  },
  {
    mineral: "malachite",
    free: true,
    title: "Conceal student flags",
    body: `${flags.summary} The switch sits in Toddle's header and the extension's menu, and stays as you left it, so you can set it before a lesson.`,
  },
  {
    mineral: "gold",
    free: false,
    title: "Excel or CSV export",
    body: "The table you are looking at, as an Excel workbook: a row per student, a column per criterion, in the same colours, with the headings frozen, a filter on every column and every comment in full. A second sheet lists every result on its own row, and the same list is one click away as a CSV. Generated in your browser and saved by your browser — it never passes through a server of ours, because there isn't one.",
  },
  {
    mineral: "tanzanite",
    free: true,
    title: "My classes",
    body: "The Toddle home page's course filter gains a third option beside All courses and My courses: only the classes you actually teach. It switches on and off at once, it is remembered, and a tag by the heading says when it is on. It only appears where you are on a class.",
  },
  {
    mineral: "terracotta",
    free: false,
    title: "The student sidebar",
    body: "Click a student anywhere they appear in Toddle — class pages, name links, gradebook student cells, every tab of the Attendance dashboard — and they dock to the side until you close it: one larger photo, grade · age · class of, their email (click to copy it, or the envelope to write), Student Group, room number, homeroom advisor, and contacts with their relationship, tap-to-call phone and email. In School setup, Toddle's admin portal, it steps aside, so a click there does what Toddle does.",
  },
  {
    mineral: "copper",
    free: false,
    title: "Now, and today's timetable",
    body: "Beside the photo, a Now card: the student's attendance code for the block happening now, the block, class, room and timetabled teacher. Today's timetable is its own part: today's periods in time order with each one's attendance code, “No classes today”, or “Couldn't load timetable” with a Retry button. The rest of the panel never waits for it.",
  },
  {
    mineral: "sodalite",
    free: false,
    title: "The class view, and messages",
    body: "Click a class for the block it is in now, its primary teacher, parent course and room, and every teacher with their display title and email. Tick the teachers you want and email them all at once, or copy their addresses. Message buttons for staff, the student, the family and each family member open Toddle's own chat, under your school's messaging rules.",
  },
  {
    mineral: "cobalt",
    free: false,
    title: "The Attendance dashboard",
    body: "On the Students tab, each name gains the student's grade or year group and where they should be right now — “Now: class · teacher” — and the current block's column is outlined, moving on by itself as the day does.",
  },
  {
    mineral: "gold",
    free: false,
    title: "Primary teacher names",
    body: "The class's primary teacher, as ticked in the class settings, beside every class on the home page and on a student's profile — so you know who to ask without opening the class.",
  },
  {
    mineral: "sodalite",
    free: true,
    title: "It tells you when Toddle changes",
    body: "Toddle changes its pages without notice. Each feature checks, in your own Toddle tab, that it still finds what it needs, and the licence page shows each one as working, working with something changed, or paused because Toddle changed — paused cleanly, never half-drawn. Send us a report in one click, or switch on sending them automatically (it is off unless you do). A report says what changed in Toddle's page, masked, and carries no student data.",
  },
];

/* The same screenshots as the Chrome Web Store listing. Each one already
   carries its headline in the picture, so the caption only names the feature
   and whether it needs a licence. Every name, email, phone number, ID and
   photo in them is made-up test data or a grey placeholder, and the school is
   a demo — replace them only with images made the same way. Astro turns them
   into AVIF and WebP at build time. */
const formats: ImageOutputFormat[] = ["avif", "webp"];
const widths = [640, 960, 1280];

const leadShot = {
  src: gradebookShot,
  alt: "The Toddle gradebook with each assessment's checklist, standards and learning goals expanded into a column per criterion, every student's result in its own cell. Test data.",
  caption: "Per-criterion columns · With a licence",
};

const shots = [
  {
    src: sidebarShot,
    alt: "Toddle's Attendance dashboard with the student sidebar open on the right: the student's grade, age and Class of, today's code, a Now card naming the current block, class, room and teachers, and their homeroom advisor. Test data.",
    caption: "The student sidebar · With a licence",
  },
  {
    src: todayShot,
    alt: "The student sidebar's Today tab beside the dashboard's period columns: each of the student's lessons today with its block, times, room, teachers and that period's attendance code, the current one first. Test data.",
    caption: "Now and Today · With a licence",
  },
  {
    src: licenceShot,
    alt: "The extension's licence page reading Licensed: an organisation licence until 2 October 2027, to be checked against the Toddle account the next time Toddle opens. Test data.",
    caption: "Your licence, checked on your machine",
  },
  {
    src: myClassesShot,
    alt: "The Toddle home page's course filter open, with My classes selected beside All courses and My courses, above the list of classes; teacher names are hidden behind grey bars.",
    caption: "My classes · Free",
  },
  {
    /* Taken in version 0.8.2, which hid flags; retake it on 0.9.0. The alt
       text describes the picture as it is. */
    src: flagsShot,
    alt: "A student's profile card in Toddle with a Show flags button where the flags would be, as in version 0.8.2; personal details are covered by grey bars.",
    caption: "The flag switch · Free",
  },
  {
    /* Taken in version 0.8.2; 0.9.0 has a switch for every feature, grouped
       by where it works. Retake it on 0.9.0. */
    src: menuShot,
    alt: "The extension's toolbar menu in version 0.8.2: the organisation licence and version, a Show student flags switch under Free, Student sidebar and Primary teacher names switches under With a licence, and Send feedback and Help.",
    caption: "The toolbar menu",
  },
  {
    src: feedbackShot,
    alt: "The Send feedback form in the extension's menu, with a topic, a message box, an optional email field and a note that only what you type and the version number are sent.",
    caption: "Send feedback",
  },
  {
    src: welcomeShot,
    alt: "The welcome page the extension opens on install: what it does on Toddle, what is free and what needs a licence, and a note that it is a closed loop that sends nothing anywhere on its own.",
    caption: "The welcome page, on install",
  },
];

const facts = [
  {
    label: "Where it runs",
    value:
      "Only on web.toddleapp.com. It has no access to any other site. The flag switch, the student sidebar, the home page's additions, the gradebook's toolbar and controls, and the Attendance dashboard's details run in the extension's own isolated part of the browser, drawn inside closed shadow roots that no script on Toddle's page can read or click into.",
  },
  {
    label: "What it reads",
    value:
      "What Toddle already lets you see — gradebook results, rubric descriptors and levels as your school set them up, class staff, student details, today's timetable and attendance, and a student's flags each time the sidebar opens — through an exact list of read-only queries to Toddle's own API, for you at the screen, reusing the session you are already signed in with. It never asks for your password. Toddle's sign-in headers stay in the tab's memory, in one script in Toddle's page, and go nowhere but Toddle.",
  },
  {
    label: "What it writes",
    value:
      "Nothing. Every request it makes is a read, and writes are blocked outright. Message buttons open Toddle's own chat; the extension sends no message itself.",
  },
  {
    label: "What it sends",
    value:
      "Nothing it reads, anywhere but back to Toddle. No account, no analytics, no tracking, no remote code. Student photos load from wherever Toddle serves them, as on Toddle's own page. Licence keys are checked on your machine: a key may name your email or your school's email domain, and where it does, that is compared with your Toddle account in the browser only. The welcome page it opens on install is part of the extension and contacts nothing.",
  },
  {
    label: "Its three outside connections",
    value:
      `The Send feedback form, only when you press Send: what you typed and the version number, to our feedback form, processed by Formspree; a Toddle compatibility report goes the same way, masked and with no student data, only when you press Send report or have switched on sending them automatically. Only while there is a licence, at most one request a day to licenses.nyuchi.com (versions before ${extensionVersions.changedIn} asked licences.nyuchi.dev, the same server) for a signed list of cancelled keys' fingerprints, which sends no key, no identifiers and no Toddle data; if it fails, the last result stands. And only when you use the one-time link from your licence email, one request to licenses.nyuchi.com carrying the link's code and nothing else, which returns your key once.`,
  },
  {
    label: "What it stores",
    value:
      `On your own machine: your switch settings, your licence key if you have one (a school's is read from its Chrome policy instead), the result of the last check for cancelled keys, the email of the Toddle account last seen signed in, to check who a licence is for, and the masked Toddle compatibility record; and, in Toddle's own site storage, whether flags are concealed, your My classes choice and the academic year Toddle is showing. ${licenceSync.short} No student data: what it reads is held in the tab's memory until the tab is closed or reloaded, and never written to storage.`,
  },
];

const title = "Toddle Enhancement Extension — Nyuchi Learning";
const description =
  "A Chrome extension for the Toddle gradebook: every rubric expanded into per-criterion columns, Excel or CSV export, a student sidebar, and a free switch that conceals student flags when your screen is shared.";

/* The claims here are the ones a search result or an assistant will repeat, so
   they mirror the privacy policy rather than the marketing copy. */
const schema = [
  {
    "@type": "SoftwareApplication",
    "@id": "https://learning.nyuchi.com/toddle-enhancement-extension#software",
    name: toddleExtension.name,
    applicationCategory: "BrowserApplication",
    operatingSystem: "Chrome, Chromium-based browsers",
    description,
    url: "https://learning.nyuchi.com/toddle-enhancement-extension",
    ...(live
      ? {
          downloadUrl: toddleExtension.webStore,
          installUrl: toddleExtension.webStore,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        }
      : {}),
    publisher: { "@id": "https://learning.nyuchi.com/#organization" },
    featureList: [
      "Expands every Toddle assessment tool into per-criterion columns",
      "Conceals student flags across Toddle with one free switch, for a shared screen; never hides Toddle's own flags",
      "Excel or CSV export of results and submission status",
      "A My classes filter on the Toddle home page",
      "A student sidebar anywhere a student appears in Toddle: photo, grade, email, contacts, where they are now, today's timetable and attendance",
      "A class view with every teacher, and message buttons that open Toddle's own chat",
      "The Attendance dashboard's Students tab with each student's year group, current class and teacher",
      "Primary teacher names beside each class",
      "A Toddle compatibility check that says when a change to Toddle affects a feature, and pauses that feature cleanly",
    ],
    privacyPolicy: "https://learning.nyuchi.com/legal/privacy",
  },
];

/* Problem → outcome: three of the shots, each beside what it changes. The
   rest stay in the gallery below. */
const outcomes = [
  {
    shot: shots[0],
    eyebrow: "With a licence",
    title: "Click a student. Everything about them, docked beside you.",
    body: "Anywhere a student appears in Toddle, one click opens the student sidebar: grade, age and class of, their email, contacts, homeroom advisor, and a Now card for the block they are in, with today's timetable and attendance codes below it.",
  },
  {
    shot: shots[4],
    eyebrow: "Free",
    title: "Share your screen without a second thought.",
    body: `${flags.summary}`,
  },
  {
    shot: shots[3],
    eyebrow: "Free",
    title: "Only the classes you teach.",
    body: "The Toddle home page's course filter gains My classes beside All courses and My courses. It is remembered, and a tag by the heading says when it is on.",
  },
];
const gallery = shots.filter((shot) => !outcomes.some((o) => o.shot === shot));

const freeFeatures = features.filter((feature) => feature.free);
const paidFeatures = features.filter((feature) => !feature.free);

const faq = [
  {
    q: "What happens when Toddle changes?",
    a: `<p>Toddle does not publish an API for this, so the extension reads the same internal interface the Toddle web app uses, reverse-engineered from the app's own requests. That works well and costs one request per assessment rather than one per student, but it also means a Toddle release can break it, usually by renaming something.</p><p>Each feature checks, in your own Toddle tab, that it still finds what it needs. When Toddle has changed something, the licence page's Toddle compatibility card says which feature is affected, and that feature pauses cleanly rather than breaking your gradebook. Send us the report from that card, in one click, and we will chase the change; it says what changed in Toddle's page, masked, and carries no student data.</p>`,
  },
  {
    q: "How do updates reach us?",
    a: `<p>Fixes are made and tested as small test builds with schools piloting the extension, which do not go to the Chrome Web Store. When a batch of them is ready, it is published to the store as the next version, and Chrome installs it on its own. <a href="/toddle-enhancement-extension/releases" class="link">What changed in each version</a>.</p>`,
  },
  {
    q: "Does activating a licence send anything to you?",
    a: `<p>Only the code in your licence email's one-time link, once, to get your key. A key is then checked on your own machine, so it works offline, and one key covers your laptop and your classroom desktop; a key you paste contacts nothing at all. ${licenceSync.short} While there is a licence, the extension checks at most once a day for cancelled keys, sending nothing about you.</p>`,
  },
  {
    q: "Can our IT team read the code?",
    a: `<p>Yes. A Chrome extension is a folder of readable JavaScript: they can unpack the installed package and read every line of it. Reading it to check what it does is welcome; the code is ours, and is not licensed for reuse elsewhere (see <a href="/legal/terms#ownership" class="link">who owns the extension</a>). We will also answer specific questions at <a href="mailto:${toddleExtension.supportEmail}" class="link">${toddleExtension.supportEmail}</a>.</p>`,
  },
  {
    q: "Which browsers does it work in?",
    a: `<p>Chrome and Chromium browsers, installed from the Chrome Web Store. There is no download, no .zip and no Developer mode.</p>`,
  },
  {
    q: "How do refunds work?",
    a: `<p>${refunds.rule} ${refunds.how} ${refunds.key}</p>`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/toddle-enhancement-extension"
  schema={schema}
>
  <Hero
    layout="split"
    variant="showcase"
    badge={live
      ? `Live on the Chrome Web Store · version ${extensionVersions.current}`
      : undefined}
    subtitle="Classroom tools · Nyuchi Web Services"
    title={toddleExtension.name}
    description={`${toddleExtension.tagline} Built for schools, and it sends your students' data precisely nowhere.`}
    primaryCTA={{ text: primaryCta.label, href: primaryCta.href, external: live }}
    secondaryCTA={{ text: live ? "See pricing" : "How to install", href: live ? "#pricing" : "#install" }}
    mediaLabel="The extension in the Toddle gradebook"
  >
    <figure slot="media">
      <div class="card overflow-hidden p-0 shadow-sm">
        <Picture
          src={leadShot.src}
          alt={leadShot.alt}
          formats={formats}
          widths={widths}
          sizes="(min-width: 1024px) 680px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div>
      <figcaption class="mt-3 text-caption text-muted-foreground">
        {leadShot.caption} ·
        {
          live
            ? "Chrome and Chromium browsers · one click from the Chrome Web Store"
            : "Chrome and Chromium browsers · going on the Chrome Web Store shortly"
        }
      </figcaption>
    </figure>
  </Hero>

  <FactStrip
    label="What it promises a school"
    facts={[
      "Runs only on web.toddleapp.com",
      "Reads, never writes",
      "Nothing from Toddle leaves your browser",
      "Flag concealing free, always",
    ]}
  />

  <!-- The problem, then what changes. -->
  <Section>
    <SectionHeader
      eyebrow="The problem"
      title="Toddle shows a rubric as one icon per student."
      description="You open a side panel to read each result, one student at a time. And what the gradebook shows is exactly what you do not want on a projector. The extension puts one column per standard, criterion or checklist item on the grid, with every student's result visible at once."
    />
    <div class="mt-12 space-y-14 md:mt-16 md:space-y-20">
      {
        outcomes.map((outcome, index) => (
          <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-14">
            <figure
              class:list={[
                "min-w-0 lg:col-span-7",
                index % 2 === 1 && "lg:order-2",
              ]}
            >
              <div class="card overflow-hidden p-0">
                <Picture
                  src={outcome.shot.src}
                  alt={outcome.shot.alt}
                  formats={formats}
                  widths={widths}
                  sizes="(min-width: 1024px) 700px, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </div>
              <figcaption class="mt-3 text-caption text-muted-foreground">
                {outcome.shot.caption}
              </figcaption>
            </figure>
            <div class="min-w-0 lg:col-span-5">
              <p
                class:list={[
                  outcome.eyebrow === "Free" ? "badge-success" : "badge-info",
                  "mb-4",
                ]}
              >
                {outcome.eyebrow}
              </p>
              <h3 class="font-serif text-h3 text-foreground text-balance">{outcome.title}</h3>
              <p class="mt-4 text-body text-muted-foreground text-pretty">{outcome.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Everything it does, split the way the extension splits it. -->
  <Section bg="secondary" class="border-y border-border" id="features">
    <SectionHeader
      eyebrow="What it does"
      title="Everything it adds to Toddle."
      description="Two features are free for everyone, and so is the check that tells you when Toddle changes. The rest are what a licence pays for."
    />
    {
      [
        { label: "Free", badge: "badge-success", list: freeFeatures },
        { label: "With a licence", badge: "badge-info", list: paidFeatures },
      ].map((group) => (
        <div class="mt-10">
          <p class:list={[group.badge]}>{group.label}</p>
          <div class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-6 lg:gap-8">
            {group.list.map((feature) => (
              <article class="card flex h-full flex-col p-6 md:p-7">
                <span
                  aria-hidden="true"
                  class="mb-4 inline-block h-2 w-2 rounded-full"
                  style={`background-color: var(--color-${feature.mineral});`}
                />
                <h3 class="font-serif text-h4 text-foreground text-balance">{feature.title}</h3>
                <p class="mt-3 flex-1 text-body-sm text-muted-foreground text-pretty">
                  {feature.body}
                </p>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <!-- The flag switch, at length -->
  <Section id="flags">
    <SectionHeader
      eyebrow="The flag switch"
      title="Project the gradebook. Not the students."
      size="h1"
      description="Toddle marks students with flags. They are useful — that is the point of them — and what they say is exactly what you do not want on a projector, in a screen share with a parent, in a lesson observation, or in a screenshot pasted into a planning document. One switch conceals them while your screen is shared."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-6 lg:gap-8">
      <div class="card p-6 md:p-8">
        <h3 class="font-serif text-h5 text-foreground">It conceals flags, not names</h3>
        <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
          Students stay identifiable to you — you are still teaching, and a
          gradebook of anonymous rows is no use to anyone. It is what a flag says
          that comes off the screen, because that is the piece of information the
          room should not be reading over your shoulder.
        </p>
        <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
          The extension doesn't hide Toddle's own
          flags: they stay where Toddle puts them, with their links and documents in Toddle's student popover. Concealing
          them is your choice: a new install starts with flags shown, and if you
          updated from {extensionVersions.previous}, where flags were hidden by default, or you had hidden them
          yourself, they stay concealed until you show them. {flags.reveal}
        </p>
      </div>

      <div class="card p-6 md:p-8">
        <h3 class="font-serif text-h5 text-foreground">Two details worth knowing</h3>
        <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
          <strong class="text-foreground">It stays on.</strong> The setting
          persists as you move around Toddle and across browser sessions, so it
          is something you set before a lesson rather than something you have
          to remember at the worst possible moment.
        </p>
        <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
          <strong class="text-foreground">The switch shows its state.</strong>
          It sits in the Toddle header, the same size as Toddle's own buttons, and
          reads as on or off at a glance — check it before you share, the same way
          you check the right window is selected.
        </p>
      </div>

      <!-- Nobody is served by a privacy claim that is broader than the truth. -->
      <div class="ubuntu-quote md:col-span-2 lg:col-span-1">
        <h3 class="font-serif text-h5">What it does not do</h3>
        <p class="mt-2 text-body-sm text-pretty">
          It conceals flags. It does not hide names. {flags.limit} It works by
          changing what Toddle draws, which means it depends on Toddle's own markup,
          and a Toddle release could change that. Switch it on before you share, check
          it is on, and treat it as a good screen — not as a compliance control and not
          as a substitute for your school's safeguarding practice.
        </p>
        <p class="mt-3 text-body-sm text-pretty">
          This describes version {extensionVersions.current}, on the Chrome Web Store.
        </p>
      </div>
    </div>
  </Section>

  <!-- How it works: where the data goes. -->
  <Section bg="secondary" class="border-y border-border scroll-mt-24" id="how-it-works">
    <SectionHeader
      eyebrow="How it works"
      title="Nothing from Toddle leaves your browser."
      description="It reads the gradebook you already have open, using the session you are already signed in with, and redraws it on your screen. This is everything it touches."
    />
    <div class="mt-10 md:mt-14">
      <DataFlow />
    </div>
  </Section>

  <!-- More screenshots -->
  <Section id="screenshots" class="scroll-mt-24">
    <SectionHeader eyebrow="In Toddle" title="What it looks like." />
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 md:gap-8">
      {
        gallery.map((shot) => (
          <figure class="min-w-0">
            <div class="card overflow-hidden p-0">
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={formats}
                widths={widths}
                sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
            </div>
            <figcaption class="mt-3 text-caption text-muted-foreground">
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <!-- Install -->
  <Section bg="secondary" class="border-y border-border scroll-mt-24" id="install">
    <SectionHeader
      eyebrow="Install"
      title="It is one click either way."
      size="h1"
      description="It lives on the Chrome Web Store, so there is nothing to download and nothing to configure. The only question is whether you are installing it for yourself or for a staff room."
    />

    <div class="mt-10 grid gap-6 md:gap-8 lg:grid-cols-2">
      <article class="card flex flex-col p-6 md:p-8">
        <p class="badge badge-info mb-4 self-start">For a teacher</p>
        <h3 class="font-serif text-h4 text-foreground">One click, from the Web Store</h3>
        <ol
          class="mt-4 space-y-3 text-body-sm text-muted-foreground list-decimal list-outside pl-5 marker:text-foreground/40"
        >
          <li>
            Press <strong class="text-foreground">Add to Chrome</strong>. Chrome asks you to
            confirm, and that is the install.
          </li>
          <li>
            A welcome page opens once: what it does, a switch for every feature, and a place
            for your licence if you have one.
          </li>
          <li>
            Open Toddle. The flag switch is in Toddle's header, and My classes is in the
            home page's course filter. With a licence, the per-criterion columns are in any
            gradebook (<em>Gradebook → Assessments</em>) and a click on a student opens the
            sidebar.
          </li>
        </ol>
        <p class="mt-4 flex-1 text-caption text-muted-foreground">
          No files to download, no Developer mode, nothing to unzip. Updates arrive on
          their own, the way every other Chrome extension does. Stuck?
          <a href={toddleExtension.help} rel="noopener noreferrer" class="link"
            >How to use the extension</a
          >, in our help centre.
        </p>
        <a href={primaryCta.href} {...(live ? { rel: "noopener noreferrer" } : {})} class="btn-primary mt-6 self-start">{primaryCta.label}</a>
      </article>

      <article class="card flex flex-col p-6 md:p-8">
        <p class="badge badge-success mb-4 self-start">For a school</p>
        <h3 class="font-serif text-h4 text-foreground">Push it from the Admin console</h3>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          Because it is on the Chrome Web Store, IT can install it for every teacher by its
          extension ID, with no self-hosted package to maintain and no Developer mode on
          anyone's machine. Chrome keeps it up to date from the store.
        </p>
        <ol
          class="mt-4 space-y-2 text-body-sm text-muted-foreground list-decimal list-outside pl-5 marker:text-foreground/40"
        >
          <li>
            In the Google Admin console, go to <em
              >Devices → Chrome → Apps &amp; extensions → Users &amp; browsers</em
            >, and pick the organisational unit your teachers are in. Students have no use
            for it.
          </li>
          <li>
            Add it by ID: <code class="text-foreground break-all"
              >{toddleExtension.extensionId}</code
            >, from the Chrome Web Store.
          </li>
          <li>
            Choose <strong class="text-foreground">Force install</strong> for a rollout IT
            owns, or <strong class="text-foreground">Allow install</strong> to leave it to
            each teacher. Pinning it to the toolbar puts its menu one click away.
          </li>
        </ol>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          Without the Admin console, the same force-install policy works through Group
          Policy or Intune on Windows and a configuration profile on macOS, with the ID and
          the store's update URL,
          <code class="text-foreground break-all"
            >{toddleExtension.extensionId};{toddleExtension.storeUpdateUrl}</code
          >.
        </p>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          <strong class="text-foreground">The licence.</strong> An organisation licence is
          one key for your school's email domain, and IT sets it through Chrome policy for
          the extension: in the Admin console's <em>Policy for extensions</em>, as
          <code class="text-foreground break-all">{`{ "licenceKey": { "Value": "TEE1…" } }`}</code>,
          or in the Windows registry or a macOS profile. Every teacher on a managed browser
          is then licensed without seeing or pasting the key, and the extension says
          <em>Provided by your school</em>. The key cannot be typed into the extension, so
          if your teachers pasted it into an earlier version, set the policy, or the
          licensed features stop when they update. If your network filters outbound
          traffic, allow <code class="text-foreground">{toddleExtension.licenceHost}</code>
          (and <code class="text-foreground">licences.nyuchi.dev</code>, which versions
          before {extensionVersions.changedIn} asked, for any computer Chrome has not yet updated) so the daily check for cancelled keys can run and a teacher's claim link can be redeemed. If it is blocked, licences already added keep
          working on the last result.
        </p>
        <p class="mt-3 flex-1 text-body-sm text-muted-foreground text-pretty">
          We will send you the full deployment guide, and the full answer to "what can this
          thing see?" — which somebody will ask, and should.
        </p>
        <a href={toddleExtension.enquiry} class="btn-outline mt-6 self-start">
          Talk to us about a rollout
        </a>
      </article>
    </div>
  </Section>

  <!-- Pricing -->
  <Section id="pricing" class="scroll-mt-24">
    <SectionHeader
      eyebrow="Pricing"
      title="Concealing flags is free. Always."
      size="h1"
      description="The flag switch protects a student, so it is not behind a price and never will be. The My classes filter is free too. The gradebook's per-criterion columns, the Excel and CSV exports, the student sidebar, primary teacher names and the Attendance dashboard's details are the time saving, and that is what a licence pays for."
    />
    <div class="mt-10">
      <ExtensionPricing />
    </div>

    <div class="mx-auto mt-10 grid max-w-5xl gap-6 md:grid-cols-3">
      <p class="text-caption text-muted-foreground text-pretty">
        <strong class="text-foreground">After paying.</strong> Usually within a minute, you
        get an email with a one-time link to your licence, never the key itself. Open it in
        Chrome, click <em>Add it to Chrome</em>, and the extension adds your licence: there
        is no key to copy. The link works once, for 72 hours; if it runs out, open it anyway
        and ask for a new one, which goes to the same address. A school licence's link goes
        to whoever bought it, who sets it up for every teacher through the Nyuchi console
        and Chrome policy. Once added, your licence is checked on your own machine, so it
        works offline, and it follows your Chrome account to your laptop and your classroom
        desktop; Chrome's sync carries it, and it is never sent to us. While a licence is in
        use, the extension checks at most once a day for cancelled keys, sending nothing
        about you.
      </p>
      <p class="text-caption text-muted-foreground text-pretty">
        <strong class="text-foreground">Upgrading.</strong>{" "}
        {upgrade.text}
      </p>
      <p class="text-caption text-muted-foreground text-pretty">
        <strong class="text-foreground">Refunds.</strong>{" "}
        {`${refunds.rule} ${refunds.how} ${refunds.key}`}
      </p>
    </div>
  </Section>

  <!-- Privacy facts -->
  <Section bg="secondary" class="border-y border-border">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <SectionHeader
          eyebrow="For whoever has to sign this off"
          title="What it can see, precisely."
        />
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          <strong class="text-foreground">The data schema.</strong> Every piece of Toddle
          data the extension reads, every value it stores and every request it makes is
          listed, field by field, in its data schema, written for a school's data
          protection lead or IT team. It is checked against the code on every change: a
          query the code allows that the schema does not describe fails the build. Ask us
          for a copy.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/legal/security" class="btn-primary">Read the security page</a>
          <a href="/legal/privacy" class="btn-outline">Read the privacy policy</a>
        </div>
      </div>
      <div class="lg:col-span-8">
        <TrustPoints class="lg:grid-cols-2" />
        <dl class="mt-10 grid gap-x-8 gap-y-6 border-t border-border pt-8 md:grid-cols-2">
          {
            facts.map((fact) => (
              <div>
                <dt class="text-caption font-semibold uppercase tracking-wider text-muted-foreground">
                  {fact.label}
                </dt>
                <dd class="mt-2 text-body-sm text-foreground/90 text-pretty">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <Section>
    <SectionHeader
      eyebrow="Worth knowing"
      title="Questions schools ask."
      description="It rides on Toddle, so the honest answers include what happens when Toddle changes."
      align="center"
    />
    <div class="mt-10">
      <Faq items={faq} />
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={toddleExtension.help} rel="noopener noreferrer" class="btn-outline">How to use it</a>
      <a href="/toddle-enhancement-extension/releases" class="btn-ghost">Releases</a>
      <a href={toddleExtension.enquiry} class="btn-ghost">Report a problem</a>
    </div>
  </Section>

  <CtaBand
    title={live ? "Add it to Chrome. Conceal flags today." : "Be first to hear when it is live."}
    description="It is free to install and the flag switch is free for good. A licence adds the columns, the export and the sidebar, for a teacher or a whole school."
    primary={{ text: primaryCta.label, href: primaryCta.href, external: live }}
    secondary={{ text: "Talk to us about a school", href: toddleExtension.enquiry }}
  >
    <p class="mx-auto mt-10 max-w-3xl text-center text-caption text-muted-foreground text-pretty">
      {ownership.statement}
      {toddleNotice}
    </p>
  </CtaBand>
</BaseLayout>
