---
/**
 * The product page for the Toddle Enhancement Extension.
 *
 * Written for two readers who arrive with different questions: a teacher who
 * wants to know what it does and how to get it, and an IT lead who wants to
 * know what it can see before putting it on a hundred machines. The flag
 * switch gets the most room because it is the part people will be asked to
 * justify.
 *
 * It describes version 0.9.0 (`extensionVersions.next`), the next release on
 * the Chrome Web Store, and says where 0.8.2, on the store today, differs.
 * Flags are "concealed", never "hidden": the extension no longer hides
 * Toddle's own flags (see `flags` in src/data/legal.ts).
 */
import { Picture } from "astro:assets";
import type { ImageOutputFormat } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toddleExtension } from "../data/site";
import { extensionVersions, flags, pricing, refunds, toddleNotice } from "../data/legal";
import gradebookShot from "../assets/screenshots/01-gradebook.jpg";
import sidebarShot from "../assets/screenshots/02-student-sidebar.jpg";
import todayShot from "../assets/screenshots/03-today.jpg";
import licenceShot from "../assets/screenshots/04-licence.jpg";
import myClassesShot from "../assets/screenshots/05-my-classes.jpg";
import flagsShot from "../assets/screenshots/06-flags.jpg";
import menuShot from "../assets/screenshots/07-menu.jpg";
import feedbackShot from "../assets/screenshots/08-feedback.jpg";
import welcomeShot from "../assets/screenshots/09-welcome.jpg";

/* One switch drives every call to action on this page. While there is no store
   listing the page says so and offers to take an enquiry; the moment
   `webStore` is set it becomes an install page, with no other edit. The source
   repository is private, so nothing here links to it.

   Distribution is the Chrome Web Store and only the Chrome Web Store — there is
   no download, no .zip and no Developer mode anywhere in this copy. That is a
   deliberate constraint, not an omission: "unzip this and turn on Developer
   mode" is where a teacher gives up, and a school's IT will not push a
   self-hosted package when a store ID will do. */
const live = Boolean(toddleExtension.webStore);
const primaryCta = live
  ? { label: "Add to Chrome", href: toddleExtension.webStore! }
  : { label: "Tell me when it is live", href: toddleExtension.enquiry };

/* `free` is the split the extension enforces (its docs/licensing.md and
   app/features/registry.ts): the flag switch and My classes for everyone, the
   rest with a licence. Keep it in step with `pricing` in src/data/legal.ts,
   the terms, and the licence email (nyuchi-licence-server, src/email.js). */
const features = [
  {
    mineral: "cobalt",
    free: false,
    title: "Per-criterion columns",
    body: "Toddle shows an assessment tool as one icon per student, and you open a side panel to read each one. This puts one column per standard, criterion or checklist item on the grid, with every student's result visible at once and the full wording on hover — one tool at a time, or all of an assessment's tools together.",
  },
  {
    mineral: "malachite",
    free: true,
    title: "Conceal student flags",
    body: `${flags.summary} The switch sits in Toddle's header and the extension's menu, and stays as you left it, so you can set it before a lesson.`,
  },
  {
    mineral: "gold",
    free: false,
    title: "CSV export",
    body: "Student × assessment × criterion × result × submission status, in one click. Generated in your browser and saved by your browser — it never passes through a server of ours, because there isn't one.",
  },
  {
    mineral: "tanzanite",
    free: true,
    title: "My classes",
    body: "The Toddle home page's course filter gains a third option beside All courses and My courses: only the classes you actually teach. It switches on and off at once, it is remembered, and a tag by the heading says when it is on. It only appears where you are on a class.",
  },
  {
    mineral: "terracotta",
    free: false,
    title: "The student sidebar",
    body: "Click a student anywhere they appear in Toddle — class pages, name links, gradebook student cells, every tab of the Attendance dashboard — and they dock to the side until you close it: one larger photo, grade · age · class of, their email (click to copy it, or the envelope to write), Student Group, room number, homeroom advisor, and contacts with their relationship, tap-to-call phone and email. In School setup, Toddle's admin portal, it steps aside, so a click there does what Toddle does.",
  },
  {
    mineral: "copper",
    free: false,
    title: "Now, and today's timetable",
    body: "Beside the photo, a Now card: the student's attendance code for the block happening now, the block, class, room and timetabled teacher. Today's timetable is its own part: today's periods in time order with each one's attendance code, “No classes today”, or “Couldn't load timetable” with a Retry button. The rest of the panel never waits for it.",
  },
  {
    mineral: "sodalite",
    free: false,
    title: "The class view, and messages",
    body: "Click a class for the block it is in now, its primary teacher, parent course and room, and every teacher with their display title and email. Tick the teachers you want and email them all at once, or copy their addresses. Message buttons for staff, the student, the family and each family member open Toddle's own chat, under your school's messaging rules.",
  },
  {
    mineral: "cobalt",
    free: false,
    title: "The Attendance dashboard",
    body: "On the Students tab, each name gains the student's grade or year group and where they should be right now — “Now: class · teacher” — and the current block's column is outlined, moving on by itself as the day does.",
  },
  {
    mineral: "gold",
    free: false,
    title: "Primary teacher names",
    body: "The class's primary teacher, as ticked in the class settings, beside every class on the home page and on a student's profile — so you know who to ask without opening the class.",
  },
];

/* The same screenshots as the Chrome Web Store listing. Each one already
   carries its headline in the picture, so the caption only names the feature
   and whether it needs a licence. Every name, email, phone number, ID and
   photo in them is made-up test data or a grey placeholder, and the school is
   a demo — replace them only with images made the same way. Astro turns them
   into AVIF and WebP at build time. */
const formats: ImageOutputFormat[] = ["avif", "webp"];
const widths = [640, 960, 1280];

const leadShot = {
  src: gradebookShot,
  alt: "The Toddle gradebook with each assessment's checklist, standards and learning goals expanded into a column per criterion, every student's result in its own cell. Test data.",
  caption: "Per-criterion columns · With a licence",
};

const shots = [
  {
    src: sidebarShot,
    alt: "Toddle's Attendance dashboard with the student sidebar open on the right: the student's grade, age and Class of, today's code, a Now card naming the current block, class, room and teachers, and their homeroom advisor. Test data.",
    caption: "The student sidebar · With a licence",
  },
  {
    src: todayShot,
    alt: "The student sidebar's Today tab beside the dashboard's period columns: each of the student's lessons today with its block, times, room, teachers and that period's attendance code, the current one first. Test data.",
    caption: "Now and Today · With a licence",
  },
  {
    src: licenceShot,
    alt: "The extension's licence page reading Licensed: an organisation licence until 2 October 2027, to be checked against the Toddle account the next time Toddle opens. Test data.",
    caption: "Your licence, checked on your machine",
  },
  {
    src: myClassesShot,
    alt: "The Toddle home page's course filter open, with My classes selected beside All courses and My courses, above the list of classes; teacher names are hidden behind grey bars.",
    caption: "My classes · Free",
  },
  {
    /* Taken in version 0.8.2, which hid flags; retake it on 0.9.0. The alt
       text describes the picture as it is. */
    src: flagsShot,
    alt: "A student's profile card in Toddle with a Show flags button where the flags would be, as in version 0.8.2; personal details are covered by grey bars.",
    caption: "The flag switch · Free",
  },
  {
    /* Taken in version 0.8.2; 0.9.0 has a switch for every feature, grouped
       by where it works. Retake it on 0.9.0. */
    src: menuShot,
    alt: "The extension's toolbar menu in version 0.8.2: the organisation licence and version, a Show student flags switch under Free, Student sidebar and Primary teacher names switches under With a licence, and Send feedback and Help.",
    caption: "The toolbar menu",
  },
  {
    src: feedbackShot,
    alt: "The Send feedback form in the extension's menu, with a topic, a message box, an optional email field and a note that only what you type and the version number are sent.",
    caption: "Send feedback",
  },
  {
    src: welcomeShot,
    alt: "The welcome page the extension opens on install: what it does on Toddle, what is free and what needs a licence, and a note that it is a closed loop that sends nothing anywhere on its own.",
    caption: "The welcome page, on install",
  },
];

const facts = [
  {
    label: "Where it runs",
    value:
      "Only on web.toddleapp.com. It has no access to any other site. From version 0.9.0 the flag switch, the student sidebar and the home page's additions run in the extension's own isolated part of the browser, drawn inside closed shadow roots that no script on Toddle's page can read or click into; the gradebook and the Attendance dashboard are moving the same way.",
  },
  {
    label: "What it reads",
    value:
      "What Toddle already lets you see — gradebook results, rubric descriptors and levels as your school set them up, class staff, student details, today's timetable and attendance, and a student's flags each time the sidebar opens — through an exact list of read-only queries to Toddle's own API, for you at the screen, reusing the session you are already signed in with. It never asks for your password. Toddle's sign-in headers stay in the tab's memory, in one script in Toddle's page, and go nowhere but Toddle.",
  },
  {
    label: "What it writes",
    value:
      "Nothing. Every request it makes is a read, and writes are blocked outright. Message buttons open Toddle's own chat; the extension sends no message itself.",
  },
  {
    label: "What it sends",
    value:
      "Nothing it reads, anywhere but back to Toddle. No account, no analytics, no tracking, no remote code. Student photos load from wherever Toddle serves them, as on Toddle's own page. Licence keys are checked on your machine: a key may name your email or your school's email domain, and where it does, that is compared with your Toddle account in the browser only. The welcome page it opens on install is part of the extension and contacts nothing.",
  },
  {
    label: "Its two outside connections",
    value:
      "The Send feedback form, only when you press Send: what you typed and the version number, to our feedback form, processed by Formspree. And, only while a licence is entered, at most one request a day to licences.nyuchi.dev for a signed list of cancelled keys' fingerprints, which sends no key, no identifiers and no Toddle data; if it fails, the last result stands.",
  },
  {
    label: "What it stores",
    value:
      "On your own machine only: your switch settings, your licence key if you have one, the result of the last check for cancelled keys, and the email of the Toddle account last seen signed in, to check who a licence is for; and, in Toddle's own site storage, a copy of the switches, whether flags are concealed, your My classes choice and the academic year Toddle is showing. No student data: what it reads is held in the tab's memory until the tab is closed or reloaded, and never written to storage.",
  },
];

const title = "Toddle Enhancement Extension — Nyuchi Learning";
const description =
  "A Chrome extension for the Toddle gradebook: every rubric expanded into per-criterion columns, CSV export, a student sidebar, and a free switch that conceals student flags when your screen is shared.";

/* The claims here are the ones a search result or an assistant will repeat, so
   they mirror the privacy policy rather than the marketing copy. */
const schema = [
  {
    "@type": "SoftwareApplication",
    "@id": "https://learning.nyuchi.com/toddle-enhancement-extension#software",
    name: toddleExtension.name,
    applicationCategory: "BrowserApplication",
    operatingSystem: "Chrome, Chromium-based browsers",
    description,
    url: "https://learning.nyuchi.com/toddle-enhancement-extension",
    ...(live
      ? {
          downloadUrl: toddleExtension.webStore,
          installUrl: toddleExtension.webStore,
          offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        }
      : {}),
    publisher: { "@id": "https://learning.nyuchi.com/#organization" },
    featureList: [
      "Expands every Toddle assessment tool into per-criterion columns",
      "Conceals student flags across Toddle with one free switch, for a shared screen; never hides Toddle's own flags",
      "CSV export of results and submission status",
      "A My classes filter on the Toddle home page",
      "A student sidebar anywhere a student appears in Toddle: photo, grade, email, contacts, where they are now, today's timetable and attendance",
      "A class view with every teacher, and message buttons that open Toddle's own chat",
      "The Attendance dashboard's Students tab with each student's year group, current class and teacher",
      "Primary teacher names beside each class",
    ],
    privacyPolicy: "https://learning.nyuchi.com/legal/privacy",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/toddle-enhancement-extension"
  schema={schema}
>
  <!-- Hero -->
  <section class="container-custom pt-12 md:pt-20 pb-10 md:pb-16">
    <div class="max-w-3xl">
      <p class="eyebrow">Classroom tools · Nyuchi Web Services</p>
      <h1 class="font-serif text-display-sm text-foreground text-balance">
        {toddleExtension.name}
      </h1>
      <p class="mt-6 text-body-lg text-muted-foreground text-pretty max-w-2xl">
        {toddleExtension.tagline} Built for schools, and it sends your students'
        data precisely nowhere.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
        <a href={live ? "#pricing" : "#install"} class="btn-outline"
          >{live ? "Buy a licence" : "How to install"}</a
        >
      </div>
      <p class="mt-4 text-caption text-muted-foreground">
        {
          live
            ? "Chrome and Chromium browsers · one click from the Chrome Web Store"
            : "Chrome and Chromium browsers · going on the Chrome Web Store shortly, and it will be one click"
        }
      </p>
    </div>
  </section>

  <!-- The gradebook, first: it is the thing people are buying. -->
  <div class="container-custom pb-12 md:pb-16">
    <figure class="max-w-5xl">
      <div class="card overflow-hidden p-0">
        <Picture
          src={leadShot.src}
          alt={leadShot.alt}
          formats={formats}
          widths={widths}
          sizes="(min-width: 1100px) 1024px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="block w-full h-auto"
        />
      </div>
      <figcaption class="mt-3 text-caption text-muted-foreground">
        {leadShot.caption}
      </figcaption>
    </figure>
  </div>

  <!-- What it does -->
  <section class="container-custom pb-16 md:pb-24">
    <div class="grid gap-6 md:gap-8 md:grid-cols-3">
      {
        features.map((feature) => (
          <article class="card-hover p-6 md:p-8 flex flex-col h-full">
            <span
              aria-hidden="true"
              class="inline-block w-2 h-2 rounded-full mb-4"
              style={`background-color: var(--color-${feature.mineral});`}
            />
            <h2 class="font-serif text-h4 text-foreground text-balance">{feature.title}</h2>
            <p class="mt-1 text-caption text-muted-foreground">
              {feature.free ? "Free" : "With a licence"}
            </p>
            <p class="mt-3 text-body-sm text-muted-foreground text-pretty flex-1">
              {feature.body}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Screenshots -->
  <section id="screenshots" class="container-custom pb-16 md:pb-24 scroll-mt-24">
    <div class="max-w-2xl">
      <p class="eyebrow">In Toddle</p>
      <h2 class="font-serif text-h2 text-foreground text-balance">What it looks like.</h2>
    </div>
    <div class="mt-8 grid gap-6 md:gap-8 sm:grid-cols-2">
      {
        shots.map((shot) => (
          <figure class="min-w-0">
            <div class="card overflow-hidden p-0">
              <Picture
                src={shot.src}
                alt={shot.alt}
                formats={formats}
                widths={widths}
                sizes="(min-width: 640px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="block w-full h-auto"
              />
            </div>
            <figcaption class="mt-3 text-caption text-muted-foreground">
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- The flag switch, at length -->
  <section class="bg-secondary border-y border-border">
    <div class="container-custom section">
      <div class="max-w-3xl">
        <p class="eyebrow">The flag switch</p>
        <h2 class="font-serif text-h1 text-foreground text-balance">
          Project the gradebook. Not the students.
        </h2>
        <p class="mt-6 text-body-lg text-muted-foreground text-pretty">
          Toddle marks students with flags. They are useful — that is the point of
          them — and what they say is exactly what you do not want on a projector, in a
          screen share with a parent, in a lesson observation, or in a screenshot
          pasted into a planning document. One switch conceals them while your screen
          is shared.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:gap-8 md:grid-cols-2 max-w-4xl">
        <div class="card p-6 md:p-8">
          <h3 class="font-serif text-h5 text-foreground">It conceals flags, not names</h3>
          <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
            Students stay identifiable to you — you are still teaching, and a
            gradebook of anonymous rows is no use to anyone. It is what a flag says
            that comes off the screen, because that is the piece of information the
            room should not be reading over your shoulder.
          </p>
          <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
            The extension no longer hides Toddle's own flags: they stay where Toddle puts
            them, with their links and documents in Toddle's student popover. Concealing
            them is your choice, off until you switch it on. {flags.reveal}
          </p>
        </div>

        <div class="card p-6 md:p-8">
          <h3 class="font-serif text-h5 text-foreground">Two details worth knowing</h3>
          <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
            <strong class="text-foreground">It stays on.</strong> The setting
            persists as you move around Toddle and across browser sessions, so it
            is something you set before a lesson rather than something you have
            to remember at the worst possible moment.
          </p>
          <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
            <strong class="text-foreground">The switch shows its state.</strong>
            It sits in the Toddle header, the same size as Toddle's own buttons, and
            reads as on or off at a glance — check it before you share, the same way
            you check the right window is selected.
          </p>
        </div>
      </div>

      <!-- Nobody is served by a privacy claim that is broader than the truth. -->
      <div class="mt-8 max-w-4xl ubuntu-quote">
        <h3 class="font-serif text-h5">What it does not do</h3>
        <p class="mt-2 text-body-sm text-pretty">
          It conceals flags. It does not hide names. {flags.limit} It works by
          changing what Toddle draws, which means it depends on Toddle's own markup,
          and a Toddle release could change that. Switch it on before you share, check
          it is on, and treat it as a good screen — not as a compliance control and not
          as a substitute for your school's safeguarding practice.
        </p>
        <p class="mt-3 text-body-sm text-pretty">
          This describes version {extensionVersions.next}, the next release on the
          Chrome Web Store. {flags.before}
        </p>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section id="install" class="container-custom section scroll-mt-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Install</p>
      <h2 class="font-serif text-h1 text-foreground text-balance">
        It is one click either way.
      </h2>
      <p class="mt-6 text-body text-muted-foreground text-pretty">
        It lives on the Chrome Web Store, so there is nothing to download and nothing to
        configure. The only question is whether you are installing it for yourself or for a
        staff room.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:gap-8 md:grid-cols-2">
      <article class="card p-6 md:p-8">
        <p class="badge badge-info mb-4">For a teacher</p>
        <h3 class="font-serif text-h4 text-foreground">One click, from the Web Store</h3>
        <ol
          class="mt-4 space-y-3 text-body-sm text-muted-foreground list-decimal list-outside pl-5 marker:text-foreground/40"
        >
          <li>
            Press <strong class="text-foreground">Add to Chrome</strong>. Chrome asks you to
            confirm, and that is the install.
          </li>
          <li>
            A welcome page opens once: what it does, a switch for every feature, and a box
            for a licence key if you have one.
          </li>
          <li>
            Open Toddle. The flag switch is in Toddle's header, and My classes is in the
            home page's course filter. With a licence, the per-criterion columns are in any
            gradebook (<em>Gradebook → Assessments</em>) and a click on a student opens the
            sidebar.
          </li>
        </ol>
        <p class="mt-4 text-caption text-muted-foreground">
          No files to download, no Developer mode, nothing to unzip. Updates arrive on
          their own, the way every other Chrome extension does. Stuck?
          <a href={toddleExtension.help} rel="noopener noreferrer" class="link"
            >How to use the extension</a
          >, in our help centre.
        </p>
        <a href={primaryCta.href} class="btn-primary mt-6">{primaryCta.label}</a>
      </article>

      <article class="card p-6 md:p-8">
        <p class="badge badge-success mb-4">For a school</p>
        <h3 class="font-serif text-h4 text-foreground">Push it from the Admin console</h3>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          Because it is on the Chrome Web Store, IT can install it for every teacher by its
          extension ID, with no self-hosted package to maintain and no Developer mode on
          anyone's machine. Chrome keeps it up to date from the store.
        </p>
        <ol
          class="mt-4 space-y-2 text-body-sm text-muted-foreground list-decimal list-outside pl-5 marker:text-foreground/40"
        >
          <li>
            In the Google Admin console, go to <em
              >Devices → Chrome → Apps &amp; extensions → Users &amp; browsers</em
            >, and pick the organisational unit your teachers are in. Students have no use
            for it.
          </li>
          <li>
            Add it by ID: <code class="text-foreground break-all"
              >{toddleExtension.extensionId}</code
            >, from the Chrome Web Store.
          </li>
          <li>
            Choose <strong class="text-foreground">Force install</strong> for a rollout IT
            owns, or <strong class="text-foreground">Allow install</strong> to leave it to
            each teacher. Pinning it to the toolbar puts its menu one click away.
          </li>
        </ol>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          Without the Admin console, the same force-install policy works through Group
          Policy or Intune on Windows and a configuration profile on macOS, with the ID and
          the store's update URL,
          <code class="text-foreground break-all"
            >{toddleExtension.extensionId};{toddleExtension.storeUpdateUrl}</code
          >.
        </p>
        <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
          <strong class="text-foreground">The licence.</strong> An organisation licence is
          one key for your school's email domain. A key cannot be pushed by policy, so send
          it to staff; each teacher pastes it in once, from the welcome page or the
          toolbar menu's <em>Enter a licence key</em>. If your network filters outbound
          traffic, allow <code class="text-foreground">{toddleExtension.licenceHost}</code>
          so the daily check for cancelled keys can run. If it is blocked, licences keep
          working on the last result.
        </p>
        <p class="mt-3 text-body-sm text-muted-foreground text-pretty">
          We will send you the full deployment guide, and the full answer to "what can this
          thing see?" — which somebody will ask, and should.
        </p>
        <a href={toddleExtension.enquiry} class="btn-outline mt-6">
          Talk to us about a rollout
        </a>
      </article>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="container-custom section-tight scroll-mt-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Pricing</p>
      <h2 class="font-serif text-h1 text-foreground text-balance">
        Concealing flags is free. Always.
      </h2>
      <p class="mt-6 text-body text-muted-foreground text-pretty">
        The flag switch protects a student, so it is not behind a price and never will
        be. The My classes filter is free too. The gradebook's per-criterion columns, the
        CSV export, the student sidebar, primary teacher names and the Attendance
        dashboard's details are the time saving, and that is what a licence pays for.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:gap-8 md:grid-cols-2 max-w-4xl">
      {
        pricing.map((plan, index) => (
          <article
            class:list={[
              "card p-6 md:p-8 flex flex-col",
              index === 1 && "relative overflow-hidden",
            ]}
          >
            {index === 1 && (
              <div class="absolute inset-x-0 top-0 h-[3px] bg-primary" aria-hidden="true" />
            )}
            <h3 class="font-serif text-h4 text-foreground">{plan.name}</h3>
            <p class="mt-3">
              <span class="font-serif text-h2 text-foreground">{plan.price}</span>
              <span class="text-body-sm text-muted-foreground"> {plan.period}</span>
            </p>
            <p class="mt-2 text-body-sm text-muted-foreground">{plan.who}</p>
            <ul class="mt-5 space-y-2 flex-1">
              {plan.includes.map((item) => (
                <li class="flex gap-2.5 text-body-sm text-muted-foreground">
                  <span aria-hidden="true" class="text-foreground/40">
                    &#8212;
                  </span>
                  <span class="text-pretty">{item}</span>
                </li>
              ))}
            </ul>
            <a
              href={plan.buy}
              rel="noopener noreferrer"
              class:list={[index === 1 ? "btn-primary" : "btn-outline", "mt-6"]}
            >
              Buy — {plan.price} {plan.period}
            </a>
            {index === 1 && (
              <a href={toddleExtension.enquiry} class="link mt-3 text-body-sm self-start">
                Need an invoice or a rollout plan? Talk to us
              </a>
            )}
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-caption text-muted-foreground max-w-2xl text-pretty">
      Checkout is through Buy Me a Coffee, and your licence key is emailed to you
      automatically, usually within a minute of paying. It is checked on your own machine, so activating it contacts
      nothing and works offline — and one key covers your laptop and your classroom
      desktop. While a key is entered, the extension checks once a day for cancelled keys,
      sending nothing about you.
    </p>
    <p class="mt-3 text-caption text-muted-foreground max-w-2xl text-pretty">
      <strong class="text-foreground">Refunds.</strong>{" "}
      {`${refunds.rule} ${refunds.how} ${refunds.key}`}
    </p>
  </section>

  <!-- Privacy facts -->
  <section class="bg-secondary border-y border-border">
    <div class="container-custom section-tight">
      <div class="max-w-2xl">
        <p class="eyebrow">For whoever has to sign this off</p>
        <h2 class="font-serif text-h2 text-foreground text-balance">
          What it can see, precisely.
        </h2>
      </div>
      <dl class="mt-8 grid gap-x-8 gap-y-6 md:grid-cols-2 max-w-4xl">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-caption font-semibold uppercase tracking-wider text-muted-foreground">
                {fact.label}
              </dt>
              <dd class="mt-2 text-body-sm text-foreground/90 text-pretty">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-8 text-body-sm text-muted-foreground max-w-2xl text-pretty">
        <strong class="text-foreground">The data schema.</strong> Every piece of Toddle
        data the extension reads, every value it stores and every request it makes is
        listed, field by field, in its data schema, written for a school's data
        protection lead or IT team. It is checked against the code on every change: a
        query the code allows that the schema does not describe fails the build. Ask us
        for a copy.
      </p>
      <p class="mt-4 text-body-sm text-muted-foreground max-w-2xl text-pretty">
        If your IT team would rather verify this than take our word for it, a
        Chrome extension is a folder of readable JavaScript — they can unpack
        the installed package and read every line of it. We will also answer
        specific questions at
        <a
          href={`mailto:${toddleExtension.supportEmail}`}
          class="link"
          >{toddleExtension.supportEmail}</a
        >.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/legal/security" class="btn-primary">Read the security page</a>
        <a href="/legal/privacy" class="btn-outline">Read the privacy policy</a>
      </div>
    </div>
  </section>

  <!-- Honesty about fragility -->
  <section class="container-custom section">
    <div class="max-w-2xl">
      <p class="eyebrow">Worth knowing</p>
      <h2 class="font-serif text-h2 text-foreground text-balance">It rides on Toddle.</h2>
      <p class="mt-6 text-body text-muted-foreground text-pretty">
        Toddle does not publish an API for this, so the extension reads the same internal
        interface the Toddle web app uses, reverse-engineered from the app's own requests.
        That works well and costs one request per assessment rather than one per student —
        but it also means a Toddle release can break it, usually by renaming something.
      </p>
      <p class="mt-4 text-body text-muted-foreground text-pretty">
        When that happens the extension falls back to its own table rather than breaking the
        gradebook, and tells you when something could not be expanded rather than
        quietly showing you less. Report a break and we will chase the rename.
      </p>
      <p class="mt-4 text-body text-muted-foreground text-pretty">
        <strong class="text-foreground">How updates reach you.</strong> Fixes are made and
        tested as small patch releases, which do not go to the Chrome Web Store. When a
        batch of them is ready, it is published to the store as the next version ({extensionVersions.next} is
        next), and Chrome installs it on its own.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={toddleExtension.help} rel="noopener noreferrer" class="btn-primary"
          >How to use it</a
        >
        <a href={toddleExtension.enquiry} class="btn-outline">Report a problem</a>
        <a href={`mailto:${toddleExtension.supportEmail}`} class="btn-ghost">
          {toddleExtension.supportEmail}
        </a>
      </div>
      <p class="mt-8 text-caption text-muted-foreground text-pretty">{toddleNotice}</p>
    </div>
  </section>
</BaseLayout>
