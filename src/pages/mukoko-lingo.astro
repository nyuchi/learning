---
/**
 * The product page for Mukoko Lingo: a partner app developed by Nyuchi
 * Learning. Part of Mukoko by Nyuchi.
 *
 * Written for organisations first (owner, 2026-10-15): schools, businesses
 * (B2B) and government (B2G), as well as single learners.
 *
 * Built the way the Toddle Enhancement Extension's page is built: a hero with
 * one call to action, a grid of what it does, a section for organisations, and
 * the plain facts an IT lead will ask for.
 *
 * Every claim is taken from Lingo's own public repository
 * (mukoko-dev/mukoko-lingo: README.md, app.json, BRANDING.md, and the app's
 * own copy in lib/data/translations.ts and app/welcome). Nothing is promised
 * that the repository does not say: no app store link and no organisation
 * price. Swahili is listed as beta, by the owner's decision. Add the rest
 * when they exist.
 *
 * The icon is the app's own (assets/images/icon.png in that repository, MIT
 * licensed). Its PNG wordmarks still read "Nyuchi Lingo", the old name, so
 * they are not used.
 */
import { Image } from "astro:assets";
import Hero from "@bundu/ui/Hero.astro";
import Section from "@bundu/ui/Section.astro";
import SectionHeader from "@bundu/ui/SectionHeader.astro";
import Icon from "@bundu/ui/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FactStrip from "../components/FactStrip.astro";
import LingoFlow from "../components/LingoFlow.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { mukokoLingo } from "../data/site";
import lingoIcon from "../assets/lingo/icon.png";

/* The repository is public, so linking to it is safe (unlike the extension's,
   which is private and must never be linked). */
const source = "https://github.com/mukoko-dev/mukoko-lingo";
const licence = `${source}/blob/main/LICENSE`;

const languageList = "Shona, Ndebele, English and Chinese";
const betaList = mukokoLingo.betaLanguages.join(", ");

/* What it does today, from the README's "What it is" and the app's own
   feature list on its welcome page. */
const features = [
  {
    mineral: "cobalt",
    title: "Five phrases a day",
    body: "Each day's lesson is five phrases. You practise them with flash cards, then a short quiz.",
  },
  {
    mineral: "tanzanite",
    title: "Review at the right time",
    body: "Spaced repetition decides which phrases come back, and when, so earlier phrases keep returning for practice.",
  },
  {
    mineral: "gold",
    title: "Shamwari, the AI tutor",
    body: "Ask Shamwari (“friend” in Shona) a question in chat. It adapts to the level the app has measured, not to a level you picked for yourself.",
  },
  {
    mineral: "malachite",
    title: "Four languages, and Swahili in beta",
    body: `${languageList}, with phrases compared across them and pronunciation guides for all four. ${betaList} is in beta.`,
  },
  {
    mineral: "terracotta",
    title: "Cultural context",
    body: "Usage examples, and when a phrase is the right thing to say. Phrases for real situations: greetings, getting around, shopping, emergencies and work.",
  },
  {
    mineral: "sodalite",
    title: "Progress you can see",
    body: "Streaks, XP, bookmarks, and how strong you are in each skill, on one dashboard.",
  },
];

/* Who it is for: organisations first (business, government, schools),
   then the app's own "Perfect for" list of single learners. */
const audiences = [
  {
    badge: "badge badge-accent",
    label: "For business and government",
    title: "Train the people who serve the public",
    body: "Staff who deal with customers and citizens learn the languages those people speak. Set the work, measure it with assessments, and run it for the whole organisation from one console.",
  },
  {
    badge: "badge badge-success",
    label: "For schools",
    title: "Set the work, see the progress",
    body: "Create a class, set assignments against specific phrases and skills, sync rosters from your school's system, and watch each student's progress.",
  },
  {
    badge: "badge badge-info",
    label: "For a learner",
    title: "Learn the language around you",
    body: "Travellers, people living and working somewhere new, and locals building on a language they already have. Starting is free.",
  },
];

const facts = [
  {
    label: "Languages",
    value: `${languageList}. ${betaList} is in beta. The app's screens are available in the four supported languages.`,
  },
  {
    label: "Where it runs",
    value: `In a web browser, at ${mukokoLingo.url.replace("https://", "")}. Organisations and their admins use the console at ${mukokoLingo.console.replace("https://", "")}.`,
  },
  {
    label: "Assessments",
    value: "Diagnostic, formative and summative. They are graded on the server, not on the learner's device, so a score cannot be edited before it is recorded.",
  },
  {
    label: "Class rosters",
    value: "Rosters sync in over OneRoster from Clever, ClassLink and PowerSchool.",
  },
  {
    label: "Moderation",
    value: "Three layers on what learners type to the tutor: rule-based guardrails, an AI check, and detection of attempts to manipulate the tutor (prompt injection). Shamwari never claims to be human.",
  },
  {
    label: "Sign-in and AI",
    value: "Sign-in is through WorkOS AuthKit. The tutor runs on Cloudflare Workers AI, called from Lingo's own servers; the AI credentials never reach a learner's device.",
  },
  {
    label: "Admin controls",
    value: "Organisation admins manage users, content, moderation, guardrails, analytics and API keys.",
  },
  {
    label: "Source code",
    value: "Open source, under the MIT licence. Anyone can read how it works.",
  },
];

const title = "Mukoko Lingo — language learning — Nyuchi Learning";
const description =
  "Mukoko Lingo teaches Shona, Ndebele, English and Chinese: five phrases a day, spaced repetition, and Shamwari, an AI tutor. Classes, assignments and assessments for schools, businesses and government. Developed by Nyuchi Learning. Part of Mukoko by Nyuchi.";

/* The claims here are the ones a search result or an assistant will repeat,
   so they are the repository's, word for word where possible. No `offers`:
   the app says "Start for free", but there is no published price for organisations,
   and a price of 0 would claim more than that. */
const schema = [
  {
    "@type": "SoftwareApplication",
    "@id": "https://learning.nyuchi.com/mukoko-lingo#software",
    name: mukokoLingo.name,
    applicationCategory: "EducationalApplication",
    operatingSystem: "Web browser",
    description,
    url: "https://learning.nyuchi.com/mukoko-lingo",
    sameAs: [mukokoLingo.url],
    inLanguage: [...mukokoLingo.languageCodes],
    author: {
      "@type": "Organization",
      name: "Nyuchi Learning",
      parentOrganization: { "@id": "https://learning.nyuchi.com/#organization" },
    },
    publisher: { "@id": "https://learning.nyuchi.com/#organization" },
    brand: { "@type": "Brand", name: "Mukoko" },
    license: "https://opensource.org/licenses/MIT",
    featureList: [
      "Teaches Shona, Ndebele, English and Chinese, with Swahili in beta",
      "For schools, businesses and government, as well as single learners",
      "Five phrases a day, with flash cards and a short quiz",
      "Spaced repetition schedules what comes back and when",
      "Shamwari, an AI tutor that adapts to the learner's measured proficiency",
      "Pronunciation guides and cultural context",
      "Classes, assignments and per-student progress for teachers",
      "Diagnostic, formative and summative assessments, graded on the server",
      "Roster sync over OneRoster from Clever, ClassLink and PowerSchool",
      "Three layers of content moderation on what learners type to the tutor",
    ],
  },
];

const faq = [
  {
    q: "Is it free?",
    a: `<p>Starting is free: open <a href="${mukokoLingo.url}" rel="noopener noreferrer" class="link">lingo.mukoko.com</a> and take today's five phrases. For a school, a team or a government department, <a href="${mukokoLingo.enquiry}" class="link">write to us</a> about running it for your organisation.</p>`,
  },
  {
    q: "Which languages can we learn?",
    a: `<p>${languageList}, with pronunciation guides for all four and phrases compared across them. ${betaList} is in beta.</p>`,
  },
  {
    q: "Can we bring our class rosters?",
    a: `<p>Yes. Rosters sync in over OneRoster from Clever, ClassLink and PowerSchool.</p>`,
  },
  {
    q: "How is what learners type to the tutor kept safe?",
    a: `<p>Three layers of moderation: rule-based guardrails, an AI check, and detection of attempts to manipulate the tutor. Shamwari never claims to be human, and the AI credentials never reach a learner's device.</p>`,
  },
  {
    q: "Can our IT team see how it works?",
    a: `<p>Yes. Mukoko Lingo is open source, under the MIT licence: <a href="${source}" rel="noopener noreferrer" class="link">read the code</a>.</p>`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="/mukoko-lingo"
  schema={schema}
  action={{ label: "Start learning", short: "Start", href: mukokoLingo.url, external: true }}
>
  <Hero
    layout="split"
    variant="showcase"
    badge="Live in your browser · starting is free"
    subtitle="Language learning · Nyuchi Learning"
    title={mukokoLingo.name}
    description="Language training for schools, businesses and government. Learn Shona, Ndebele, English or Chinese, five phrases a day, with an AI tutor that meets each learner at their level, while you set the work and see who is keeping up."
    primaryCTA={{ text: "Start learning", href: mukokoLingo.url, external: true }}
    secondaryCTA={{ text: "For organisations", href: "#organisations" }}
    mediaLabel="Mukoko Lingo at a glance"
  >
    <div slot="media" class="card p-6 md:p-8">
      <div class="flex items-center gap-4">
        <Image
          src={lingoIcon}
          alt=""
          width={64}
          height={64}
          densities={[1, 2]}
          loading="eager"
          class="h-14 w-14 shrink-0 rounded-xl md:h-16 md:w-16"
        />
        <div class="min-w-0">
          <p class="font-serif text-h4 text-foreground">{mukokoLingo.name}</p>
          <a href={mukokoLingo.url} rel="noopener noreferrer" class="text-body-sm text-muted-foreground underline-offset-4 hover:underline">
            {mukokoLingo.url.replace("https://", "")}
          </a>
        </div>
        <span class="badge-success ml-auto shrink-0">Live</span>
      </div>

      <p class="eyebrow mt-6">Languages</p>
      <ul class="flex flex-wrap gap-2">
        {
          mukokoLingo.languages.map((language) => (
            <li class="badge border border-border bg-card text-foreground">{language}</li>
          ))
        }
        {
          mukokoLingo.betaLanguages.map((language) => (
            <li class="badge-info">{language} · beta</li>
          ))
        }
      </ul>

      <ul class="mt-6 divide-y divide-border border-t border-border">
        <li class="flex items-center gap-3 py-3 text-body-sm text-foreground">
          <Icon name="book" class="h-4 w-4 shrink-0 text-muted-foreground" />
          Five phrases a day, with spaced repetition
        </li>
        <li class="flex items-center gap-3 py-3 text-body-sm text-foreground">
          <Icon name="message" class="h-4 w-4 shrink-0 text-muted-foreground" />
          Shamwari, the AI tutor
        </li>
        <li class="flex items-center gap-3 py-3 text-body-sm text-foreground">
          <Icon name="chart" class="h-4 w-4 shrink-0 text-muted-foreground" />
          Classes, assignments and assessments for organisations
        </li>
      </ul>

      <p class="mt-4 text-body-sm text-muted-foreground text-pretty">
        A partner app developed by Nyuchi Learning. Part of
        <a href="https://mukoko.com" rel="noopener noreferrer" class="link">Mukoko</a> by
        Nyuchi.
      </p>
      <!-- TODO(owner): a real screenshot of the app (lesson and console), made
           with test data the way the extension's are, would be the strongest
           visual here. None is in the repo yet. -->
    </div>
  </Hero>

  <FactStrip
    label="Mukoko Lingo, in short"
    facts={[
      `${languageList}`,
      `${betaList} in beta`,
      "Assessments graded on the server",
      "Open source, MIT licence",
    ]}
  />

  <!-- How it works: two lanes, learner and organisation. -->
  <Section bg="secondary" id="how-it-works" class="scroll-mt-24">
    <SectionHeader
      eyebrow="How it works"
      title="Learners practise. You set the work and see it land."
      description="Lingo has two halves: learners use the app, and the people running the programme use the console, where the work is set and measured."
    />
    <div class="mt-10">
      <LingoFlow />
    </div>
  </Section>

  <!-- What it does -->
  <Section>
    <SectionHeader
      eyebrow="What it does today"
      title="Five phrases a day, and a tutor to ask."
    />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 md:gap-6 lg:gap-8">
      {
        features.map((feature) => (
          <article class="card flex h-full flex-col p-6 md:p-7">
            <span
              aria-hidden="true"
              class="mb-4 inline-block h-2 w-2 rounded-full"
              style={`background-color: var(--color-${feature.mineral});`}
            />
            <h3 class="font-serif text-h4 text-foreground text-balance">{feature.title}</h3>
            <p class="mt-3 flex-1 text-body-sm text-muted-foreground text-pretty">
              {feature.body}
            </p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Who it is for -->
  <Section bg="secondary" class="border-y border-border">
    <SectionHeader
      eyebrow="Who it is for"
      title="One app, from a single learner to a whole organisation."
      size="h1"
    />
    <div class="mt-10 grid gap-6 md:grid-cols-3 md:gap-6 lg:gap-8">
      {
        audiences.map((audience) => (
          <article class="card p-6 md:p-8">
            <p class:list={[audience.badge, "mb-4"]}>{audience.label}</p>
            <h3 class="font-serif text-h4 text-foreground text-balance">{audience.title}</h3>
            <p class="mt-3 text-body-sm text-muted-foreground text-pretty">{audience.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- For organisations: schools, businesses and government -->
  <Section id="organisations" class="scroll-mt-24">
    <SectionHeader
      eyebrow="For schools, businesses and government"
      title="Language training you can assign and measure."
      size="h1"
      description="For a school teaching a language, a business training the staff who serve its customers, or a government department whose people serve the public in their own languages."
    />

    <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-8">
      <article class="card p-6 md:p-8">
        <h3 class="font-serif text-h4 text-foreground">For teachers and trainers</h3>
        <ul class="mt-4 space-y-3">
          {
            [
              "Create classes and learner groups.",
              "Set assignments against specific phrases and skills.",
              "See each learner's progress, skill by skill.",
              "Use diagnostic, formative and summative assessments. They are graded on the server, so the score you see is the score the learner earned.",
            ].map((item) => (
              <li class="flex gap-2.5 text-body-sm text-muted-foreground">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-malachite" />
                <span class="text-pretty">{item}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="card p-6 md:p-8">
        <h3 class="font-serif text-h4 text-foreground">For leaders and IT</h3>
        <ul class="mt-4 space-y-3">
          {
            [
              "Schools: sync class rosters over OneRoster from Clever, ClassLink or PowerSchool.",
              "Manage users, content, moderation, guardrails, analytics and API keys.",
              "Three layers of moderation check what learners type to the AI tutor.",
              "Open source code your IT team can read.",
            ].map((item) => (
              <li class="flex gap-2.5 text-body-sm text-muted-foreground">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-malachite" />
                <span class="text-pretty">{item}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={mukokoLingo.enquiry} class="btn-primary">Talk to us about your organisation</a>
      <a href={mukokoLingo.console} rel="noopener noreferrer" class="btn-outline"
        >Open the console</a
      >
    </div>
    <!-- TODO(owner): an organisation price, or "from" price, would help a
         buyer here. The repository has none, so none is shown. -->
  </Section>

  <!-- The facts -->
  <Section bg="secondary" class="border-y border-border">
    <SectionHeader eyebrow="For whoever has to sign this off" title="The facts, plainly." />
    <dl class="mt-8 grid gap-x-8 gap-y-6 md:grid-cols-2 lg:grid-cols-4">
      {
        facts.map((fact) => (
          <div>
            <dt class="text-caption font-semibold uppercase tracking-wider text-muted-foreground">
              {fact.label}
            </dt>
            <dd class="mt-2 text-body-sm text-foreground/90 text-pretty">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={source} rel="noopener noreferrer" class="btn-outline">Read the code</a>
      <a href={licence} rel="noopener noreferrer" class="btn-ghost">MIT licence</a>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="Questions" title="Frequently asked." align="center" />
    <div class="mt-10">
      <Faq items={faq} />
    </div>
  </Section>

  <CtaBand
    eyebrow="Get it"
    title="Open it in your browser and start."
    description="Choose a language and take today's five phrases. Starting is free. For a school, a team or a government department, write to us."
    primary={{ text: "Start learning", href: mukokoLingo.url, external: true }}
    secondary={{ text: "Talk to us", href: mukokoLingo.enquiry }}
  >
    <p class="mx-auto mt-10 max-w-2xl text-center text-body-sm text-muted-foreground text-pretty">
      <strong class="text-foreground">Who makes it.</strong> Mukoko Lingo is a partner app
      developed by Nyuchi Learning. It is part of Mukoko by Nyuchi. Nyuchi Learning is
      part of <a href="https://nyuchi.com" rel="noopener noreferrer" class="link"
        >Nyuchi Africa</a
      >, which also makes the
      <a href="/toddle-enhancement-extension" class="link">Toddle Enhancement Extension</a>.
    </p>
  </CtaBand>
</BaseLayout>
