---
/**
 * Footer, and the site's canonical navigation: every page is reachable from
 * here. A brand block beside the link columns, then the legal row.
 *
 * The seven-mineral identity strip is NOT here — it is a fixed, full-height
 * element on the left edge of every page, rendered once by the layout from
 * @bundu/ui. The dots in the brand block are a separate, smaller motif.
 */
import Wordmark from "./Wordmark.astro";
import { MINERALS, footerColumns, legalLinks, site } from "../data/site";
import { toddleNotice } from "../data/legal";

const year = new Date().getFullYear();
---

<footer class="bg-canvas border-t border-border">
  <div class="container-custom py-12 md:py-20">
    <div class="grid grid-cols-2 md:grid-cols-5 lg:grid-cols-7 gap-x-6 gap-y-10 md:gap-8">
      <div class="col-span-2 md:col-span-5 lg:col-span-2">
        <Wordmark />
        <p class="mt-3 text-body-sm text-muted-foreground max-w-xs text-pretty">
          {site.description}
        </p>
        <div class="mt-5 flex items-center gap-1.5" role="img" aria-label="Seven African Minerals">
          {
            MINERALS.map((mineral) => (
              <span
                aria-hidden="true"
                title={mineral}
                class="inline-block w-2 h-2 rounded-full"
                style={`background-color: var(--color-${mineral});`}
              />
            ))
          }
        </div>
      </div>

      {
        footerColumns.map((column) => (
          <div>
            <p class="text-caption font-semibold uppercase tracking-wider text-muted-foreground mb-3">
              {column.title}
            </p>
            <ul class="space-y-2">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { rel: "noopener noreferrer" } : {})}
                    class="text-body-sm text-muted-foreground hover:text-foreground transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-custom py-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="text-caption text-muted-foreground">
          &copy; {year} {site.parent.name}. Part of the{" "}
          <a
            href="https://bundu.org"
            rel="noopener noreferrer"
            class="link"
            >Bundu Foundation</a
          >.
        </p>
        <ul class="flex items-center gap-5">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external ? { rel: "noopener noreferrer" } : {})}
                  class="text-caption text-muted-foreground hover:text-foreground transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <!-- Withdrawing consent must be as easy as giving it, so it sits in
                 the same row as the other legal links rather than buried in the
                 privacy policy. Rendered hidden and wired up by
                 CookieBanner.astro, which owns the consent state: depending on
                 a global that another component's script sets is a race, and it
                 lost — the button stayed hidden because the footer's script ran
                 first. One owner instead. -->
            <button
              type="button"
              id="cookie-choices"
              class="text-caption text-muted-foreground hover:text-foreground transition-colors"
              hidden
            >
              Cookie choices
            </button>
          </li>
        </ul>
      </div>
      <p class="mt-4 text-caption text-muted-foreground text-pretty max-w-3xl">
        {toddleNotice}
      </p>
    </div>
  </div>
</footer>

