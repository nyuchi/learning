---
/**
 * Google Analytics 4, behind Google Consent Mode v2.
 *
 * The order of the three scripts below is the whole design, and it is fragile in
 * one direction only: the consent defaults must be set BEFORE gtag/js loads. Set
 * them after and there is a window in which GA has already written a cookie, the
 * banner is still asking, and the privacy policy is wrong. That is why this is
 * one `is:inline` block emitted ahead of the loader rather than something tidier,
 * and why tests/security.test.ts asserts the ordering.
 *
 * What a visitor gets before they choose:
 *
 *   analytics_storage: denied   → no GA cookie, nothing kept on the device
 *   ad_storage, ad_user_data, ad_personalization: denied
 *
 * Consent Mode v2 requires the three ad_* signals to be declared even though
 * this site runs no advertising, so they are declared and denied permanently —
 * the banner never grants them, because there is nothing here to grant them for.
 * Only `analytics_storage` is ever flipped, by CookieBanner.astro.
 *
 * An honest caveat, because a data protection lead will find it: with consent
 * denied, GA still loads and still sends Google a cookieless ping. That is how
 * Consent Mode is designed to work, and it means "no cookies until you agree" is
 * exactly true while "no contact with Google until you agree" is not. If you need
 * the stronger claim, do not render this component until consent exists; you lose
 * Consent Mode's modelling and gain a cleaner sentence.
 *
 * Nothing here is in the extension, which sends nothing it reads anywhere
 * (its only outside connections are feedback a teacher chooses to send and a
 * data-free daily check for cancelled licence keys). This is
 * the marketing site measuring the marketing site.
 */
import { analytics } from "../data/site";
import { CONSENT_KEY, LEGACY_CONSENT_KEY } from "../data/consent";
---

{
  analytics.measurementId && (
    <>
      <script
        is:inline
        set:html={`
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}

/* Deny everything up front. This runs before the loader below, so there is no
   moment in which GA stores anything the visitor has not agreed to. */
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  wait_for_update: 500
});

/* Someone who already agreed should not spend a page view denied while we get
   round to reading their answer. Read it here, before the tag loads, rather
   than leaving it to the banner's deferred module. */
try {
  var stored = localStorage.getItem(${JSON.stringify(CONSENT_KEY)});
  var ok = false;
  if (stored) {
    ok = JSON.parse(stored).analytics === true;
  } else {
    ok = localStorage.getItem(${JSON.stringify(LEGACY_CONSENT_KEY)}) === 'granted';
  }
  if (ok) gtag('consent', 'update', { analytics_storage: 'granted' });
} catch (e) {
  /* Storage blocked, or a malformed record — stay denied, the safe direction. */
}
`}
      />
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${analytics.measurementId}`}
      />
      <script
        is:inline
        set:html={`
gtag('js', new Date());
gtag('config', '${analytics.measurementId}');
`}
      />
    </>
  )
}
