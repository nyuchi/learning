---
/**
 * The support messenger — loaded when someone asks for it, not before.
 *
 * Intercom is a third party that sets cookies and can see which pages you
 * visited. On most sites that is unremarkable; on this one the whole pitch is
 * that the software sends nothing anywhere, and the privacy policy says this
 * website tracks nothing. Booting a tracker into every visit to serve the small
 * fraction of people who want to ask a question would make that sentence false
 * for everyone.
 *
 * So nothing loads until the button is pressed. Until then this is one <button>
 * and no network activity at all — no cookie, no request, no Intercom. Press it
 * and the messenger loads, Intercom's own launcher takes over, and the privacy
 * policy's "if you open the messenger" paragraph starts applying to you.
 *
 * scripts/qa.mjs asserts that in a real browser on every page it loads. This
 * component is deliberately styled with the kit's own .btn-primary rather than
 * its own CSS: a pill button is a Mzizi mandate, and a hand-rolled copy here
 * would quietly stop following @bundu/ui the next time the button changes.
 */
import { legal } from "../data/legal";
---

<div
  class="support-widget fixed right-4 bottom-4 z-40"
  data-app-id={legal.support.intercomAppId}
  data-support-email={legal.supportEmail}
>
  <button
    type="button"
    class="btn-primary !h-10 !px-5 text-body-sm shadow-lg"
    aria-label="Open support chat"
    data-support-launcher
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <span>Support</span>
  </button>

  <!-- One piece of fallback markup, shown when there is no scripting at all and
       unhidden when the messenger fails to load. A support button that can fail
       silently is worse than no button, because the visitor believes they have
       been heard. -->
  <a
    class="btn-primary !h-10 !px-5 text-body-sm shadow-lg"
    href={`mailto:${legal.supportEmail}`}
    data-support-fallback
    hidden
  >
    Email support
  </a>
  <noscript>
    <style>
      [data-support-launcher] {
        display: none;
      }
      [data-support-fallback] {
        display: inline-flex !important;
      }
    </style>
  </noscript>
</div>

<style>
  /* The only rule this component owns: once Intercom is up it draws its own
     launcher in the same corner, and two buttons stacked on each other is
     worse than either alone. Everything else is @bundu/ui. */
  .support-widget[data-loaded="true"] [data-support-launcher] {
    display: none;
  }
</style>

<script>
  declare global {
    interface Window {
      Intercom?: (command: string, options?: unknown) => void;
      intercomSettings?: { app_id: string };
    }
  }

  /* Boot Intercom on demand. Everything here runs only after a click, so a
     visitor who never asks for support never meets a third party. */
  const widget = document.querySelector<HTMLElement>(".support-widget");
  const button = document.querySelector<HTMLButtonElement>(
    "[data-support-launcher]",
  );

  /* A one-shot latch. The button is display:none once the messenger is up, so
     there is no second press to handle and no state machine to keep in sync. */
  let started = false;

  function loadIntercom(appId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      window.intercomSettings = { app_id: appId };
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://widget.intercom.io/widget/${appId}`;
      script.addEventListener("load", () => resolve());
      script.addEventListener("error", () =>
        reject(new Error("intercom failed to load")),
      );
      document.head.appendChild(script);
    });
  }

  button?.addEventListener("click", async () => {
    const appId = widget?.dataset.appId;
    if (!appId || started) return;
    started = true;
    button.disabled = true;

    try {
      await loadIntercom(appId);
      /* Intercom auto-boots from window.intercomSettings; ask it to open. */
      window.Intercom?.("show");
      widget?.setAttribute("data-loaded", "true");
    } catch {
      /* Blocked or offline. Don't leave someone pressing a button that does
         nothing — show the email address that was in the markup all along. */
      button.hidden = true;
      widget?.querySelector<HTMLElement>("[data-support-fallback]")?.removeAttribute("hidden");
    }
  });
</script>
