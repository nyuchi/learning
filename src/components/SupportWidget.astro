---
/**
 * The support messenger — loaded when someone asks for it, not before.
 *
 * Intercom is a third party that sets cookies and can see which pages you
 * visited. On most sites that is unremarkable; on this one the whole pitch is
 * that the software sends nothing anywhere on its own. The site does carry Google Analytics
 * (see components/Analytics.astro), which is a decision taken once and written
 * into the privacy policy; it is not a reason to let every other third party in
 * on arrival too. Support is wanted by a small fraction of visitors, so it costs
 * the rest of them nothing.
 *
 * So nothing loads until the button is pressed. Until then this is one <button>
 * and no network activity at all — no cookie, no request, no Intercom. Press it
 * and the messenger loads, Intercom's own launcher takes over, and the privacy
 * policy's "if you open the messenger" paragraph starts applying to you.
 *
 * scripts/qa.mjs asserts that in a real browser on every page it loads. This
 * component is deliberately styled with the kit's own .btn-primary rather than
 * its own CSS: a pill button is a Mzizi mandate, and a hand-rolled copy here
 * would quietly stop following @bundu/ui the next time the button changes.
 */
import { legal } from "../data/legal";
---

<div
  class="support-widget fixed right-4 bottom-4 z-40"
  data-app-id={legal.support.intercomAppId}
  data-support-email={legal.supportEmail}
>
  <button
    type="button"
    class="btn-primary !h-10 !px-5 text-body-sm shadow-lg"
    aria-label="Open support chat"
    data-support-launcher
  >
    <svg
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <span>Support</span>
  </button>

  <!-- One piece of fallback markup, shown when there is no scripting at all and
       unhidden when the messenger fails to load. A support button that can fail
       silently is worse than no button, because the visitor believes they have
       been heard. -->
  <a
    class="btn-primary !h-10 !px-5 text-body-sm shadow-lg"
    href={`mailto:${legal.supportEmail}`}
    data-support-fallback
    hidden
  >
    Email support
  </a>
  <!-- Shown when someone presses Support without having answered the consent
       question. Pressing "Support" is not agreement to load a third party, so
       this says what opening the chat does and lets them decide. -->
  <div class="support-consent card" data-support-consent hidden>
    <p class="text-body-sm text-muted-foreground text-pretty">
      Opening the chat loads <strong class="text-foreground">Intercom</strong>, which
      sets its own cookies. Email works without that.
    </p>
    <div class="support-consent-actions">
      <button type="button" class="btn-primary !h-9 !px-4 text-caption" data-support-confirm>
        Open chat
      </button>
      <a
        class="btn-outline !h-9 !px-4 text-caption"
        href={`mailto:${legal.supportEmail}`}
      >
        Email instead
      </a>
    </div>
  </div>

  <noscript>
    <style>
      [data-support-launcher] {
        display: none;
      }
      [data-support-fallback] {
        display: inline-flex !important;
      }
    </style>
  </noscript>
</div>

<style>
  /* Once Intercom is up it draws its own launcher in the same corner, and two
     buttons stacked on each other is worse than either alone. Everything else
     here is @bundu/ui. */
  .support-widget[data-loaded="true"] [data-support-launcher] {
    display: none;
  }

  .support-consent {
    width: min(20rem, calc(100vw - 2rem));
    padding: 0.9rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .support-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>

<script>
  import { CONSENT_KEY } from "../data/consent";

  declare global {
    interface Window {
      Intercom?: (command: string, options?: unknown) => void;
      intercomSettings?: { app_id: string };
    }
  }

  /* Boot Intercom on demand. Everything here runs only after a click, so a
     visitor who never asks for support never meets a third party. */
  const widget = document.querySelector<HTMLElement>(".support-widget");
  const button = document.querySelector<HTMLButtonElement>(
    "[data-support-launcher]",
  );

  /* A one-shot latch. The button is display:none once the messenger is up, so
     there is no second press to handle and no state machine to keep in sync. */
  let started = false;

  /* Read the consent record from storage rather than from the banner's global.
     Both are deferred modules with no guaranteed order, and reading a global
     another module sets is a race this file has already lost once. Storage is
     there either way. */
  function supportConsent(): "granted" | "denied" | "unset" {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return "unset";
      const record = JSON.parse(raw) as { support?: boolean };
      return record.support === true ? "granted" : "denied";
    } catch {
      return "unset";
    }
  }

  function showFallback() {
    if (button) button.hidden = true;
    widget
      ?.querySelector<HTMLElement>("[data-support-fallback]")
      ?.removeAttribute("hidden");
  }

  function loadIntercom(appId: string): Promise<void> {
    return new Promise((resolve, reject) => {
      window.intercomSettings = { app_id: appId };
      const script = document.createElement("script");
      script.async = true;
      script.src = `https://widget.intercom.io/widget/${appId}`;
      script.addEventListener("load", () => resolve());
      script.addEventListener("error", () =>
        reject(new Error("intercom failed to load")),
      );
      document.head.appendChild(script);
    });
  }

  async function open(appId: string) {
    if (started) return;
    started = true;
    if (button) button.disabled = true;
    try {
      await loadIntercom(appId);
      /* Intercom auto-boots from window.intercomSettings; ask it to open. */
      window.Intercom?.("show");
      widget?.setAttribute("data-loaded", "true");
    } catch {
      /* Blocked or offline. Don't leave someone pressing a button that does
         nothing — show the email address that was in the markup all along. */
      started = false;
      showFallback();
    }
  }

  /* Somebody who turned the messenger off in the consent panel should not be
     offered it at all. Offer the email address instead, which asks nothing. */
  if (supportConsent() === "denied") showFallback();

  button?.addEventListener("click", async () => {
    const appId = widget?.dataset.appId;
    if (!appId) return;

    const consent = supportConsent();
    if (consent === "denied") {
      showFallback();
      return;
    }

    if (consent === "unset") {
      /* No answer yet. Pressing a button labelled "Support" is not consent to
         load a third party, so say what happens and let them choose — pressing
         "Open chat" on that prompt is the unambiguous affirmative act, and it
         is recorded like any other answer. */
      const prompt = widget?.querySelector<HTMLElement>("[data-support-consent]");
      if (prompt) {
        button.hidden = true;
        prompt.removeAttribute("hidden");
        prompt.querySelector<HTMLButtonElement>("[data-support-confirm]")?.focus();
        return;
      }
    }

    await open(appId);
  });

  widget
    ?.querySelector<HTMLButtonElement>("[data-support-confirm]")
    ?.addEventListener("click", async () => {
      const appId = widget?.dataset.appId;
      window.nyuchiConsent?.grant("support");
      widget
        ?.querySelector<HTMLElement>("[data-support-consent]")
        ?.setAttribute("hidden", "");
      if (appId) await open(appId);
    });
</script>
