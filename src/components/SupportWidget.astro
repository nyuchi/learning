---
/**
 * The support messenger — loaded when someone asks for it, not before.
 *
 * Intercom is a third party that sets cookies and can see which pages you
 * visited. On most sites that is unremarkable; on this one the whole pitch is
 * that the software sends nothing anywhere, and the privacy policy says this
 * website tracks nothing. Booting a tracker into every visit to serve the small
 * fraction of people who want to ask a question would make that sentence false
 * for everyone.
 *
 * So nothing loads until the button is pressed. Until then this is one <button>
 * and no network activity at all — no cookie, no request, no Intercom. Press it
 * and the messenger loads, Intercom's own launcher takes over, and the privacy
 * policy's "if you open the messenger" paragraph starts applying to you.
 *
 * The cost is one extra click for someone who wants support, paid by the person
 * who chose to ask. The alternative charges every visitor a cookie for it.
 */
import { legal } from "../data/legal";

/* Intercom's workspace id. Public by design — it is in the messenger snippet on
   every site that uses Intercom, and it identifies the workspace, not a user. */
const INTERCOM_APP_ID = "f1vga504";
---

<div class="support-widget" data-app-id={INTERCOM_APP_ID}>
  <button
    type="button"
    class="support-launcher"
    aria-label="Open support chat"
    data-support-launcher
  >
    <svg
      aria-hidden="true"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
      ></path>
    </svg>
    <span>Support</span>
  </button>

  <!-- If scripting is off, or the messenger fails to load, there is still a way
       to reach a person. A support widget that can fail silently is worse than
       no widget, because the visitor believes they have been heard. -->
  <noscript>
    <a class="support-launcher" href={`mailto:${legal.supportEmail}`}>
      <span>Email support</span>
    </a>
  </noscript>
</div>

<style>
  .support-widget {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 40;
  }

  .support-launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 150ms ease,
      filter 150ms ease;
  }

  .support-launcher:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .support-launcher:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }

  /* Once Intercom is up it draws its own launcher in the same corner; two
     buttons stacked on each other is worse than either alone. */
  .support-widget[data-loaded="true"] .support-launcher {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .support-launcher {
      transition: none;
    }
    .support-launcher:hover {
      transform: none;
    }
  }

  /* On a phone the strip owns the left edge and the thumb owns the right, so
     keep clear of both and shrink to the icon plus a short word. */
  @media (max-width: 480px) {
    .support-launcher {
      padding: 0.5rem 0.875rem;
    }
  }
</style>

<script>
  /* Boot Intercom on demand. Everything here runs only after a click, so a
     visitor who never asks for support never meets a third party. */
  const widget = document.querySelector<HTMLElement>(".support-widget");
  const button = document.querySelector<HTMLButtonElement>(
    "[data-support-launcher]",
  );
  const appId = widget?.dataset.appId;

  let state: "idle" | "loading" | "ready" = "idle";

  function loadIntercom(id: string): Promise<void> {
    return new Promise((resolve, reject) => {
      /* Queue calls made before the script lands, which is how Intercom's own
         snippet works — Intercom() is callable immediately and replays later. */
      const queue: unknown[][] = [];
      const shim = (...args: unknown[]) => queue.push(args);
      shim.q = queue;
      (window as unknown as Record<string, unknown>).Intercom = shim;
      (window as unknown as Record<string, unknown>).intercomSettings = {
        app_id: id,
      };

      const script = document.createElement("script");
      script.async = true;
      script.src = `https://widget.intercom.io/widget/${id}`;
      script.addEventListener("load", () => resolve());
      script.addEventListener("error", () =>
        reject(new Error("intercom failed to load")),
      );
      document.head.appendChild(script);
    });
  }

  button?.addEventListener("click", async () => {
    if (!appId || state !== "idle") {
      /* Already up: just reopen it. */
      if (state === "ready") {
        (window as unknown as { Intercom?: (command: string) => void }).Intercom?.(
          "show",
        );
      }
      return;
    }

    state = "loading";
    button.disabled = true;

    try {
      await loadIntercom(appId);
      const intercom = (
        window as unknown as {
          Intercom?: (command: string, options?: unknown) => void;
        }
      ).Intercom;
      intercom?.("boot", { app_id: appId });
      intercom?.("show");
      state = "ready";
      widget?.setAttribute("data-loaded", "true");
    } catch {
      /* The messenger is blocked or offline. Don't leave someone pressing a
         button that does nothing — hand them the email address instead. */
      state = "idle";
      button.disabled = false;
      const fallback = document.createElement("a");
      fallback.className = "support-launcher";
      fallback.href = "mailto:support@nyuchi.com";
      fallback.textContent = "Email support";
      button.replaceWith(fallback);
    }
  });
</script>
