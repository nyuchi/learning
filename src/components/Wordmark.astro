---
/**
 * The Nyuchi Learning wordmark.
 *
 * Capitalised, per the ecosystem branding: "Nyuchi Learning". The mark is the
 * Nyuchi bee, in the variant made for each background: honey-brown on light,
 * gold on dark. Both are in the markup and CSS shows the one that matches, so
 * the switch follows the theme toggle instantly and never flashes the wrong one.
 */
import { site } from "../data/site";

interface Props {
  href?: string;
  class?: string;
}

const { href = "/", class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-2.5 font-serif text-h5 font-bold text-foreground ${className}`}
  aria-label={`${site.wordmark} — home`}
>
  <span class="mark" aria-hidden="true">
    <img class="mark-light" src="/brand/nyuchi-bee-light.png" alt="" width="28" height="28" />
    <img class="mark-dark" src="/brand/nyuchi-bee-dark.png" alt="" width="28" height="28" />
  </span>
  {site.wordmark}
</a>

<style>
  .mark {
    display: inline-flex;
    width: 28px;
    height: 28px;
    flex: none;
  }
  .mark img {
    width: 100%;
    height: 100%;
  }

  /* The theme bootstrap sets data-theme on <html> before first paint, and the
     toggle updates it. Without JavaScript there is no attribute, so fall back
     to the system colour scheme rather than guess. */
  .mark-dark {
    display: none;
  }
  :global([data-theme="dark"]) .mark-light {
    display: none;
  }
  :global([data-theme="dark"]) .mark-dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .mark-light {
      display: none;
    }
    :global(:root:not([data-theme])) .mark-dark {
      display: block;
    }
  }
</style>
