---
/**
 * The thin strip of short, true facts under a hero, as nyuchi.com has under
 * its own. Every fact must already be documented on the site (the product
 * page, the privacy policy or src/data); this is a summary, never a new claim.
 */
import { MINERALS } from "../data/site";

interface Props {
  label: string;
  facts: string[];
}
const { label, facts } = Astro.props;
---

<section class="border-y border-border bg-canvas" aria-label={label}>
  <div class="container-custom py-6 md:py-8">
    <p class="text-center text-caption font-semibold uppercase tracking-wider text-muted-foreground">
      {label}
    </p>
    <ul
      class="mt-4 md:mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-body-sm font-medium text-foreground sm:gap-x-12"
    >
      {
        facts.map((fact, index) => (
          <li class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="inline-block h-1.5 w-1.5 shrink-0 rounded-full"
              style={`background-color: var(--color-${MINERALS[(index * 2) % MINERALS.length]});`}
            />
            {fact}
          </li>
        ))
      }
    </ul>
  </div>
</section>
