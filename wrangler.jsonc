{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyuchi-learning",
  "compatibility_date": "2026-09-28",

  // Static assets only — no "main", so no Worker script runs and every request
  // is served straight from Cloudflare's edge.
  "assets": {
    "directory": "./dist",

    // Astro emits directory-style pages (/toddle-enhancement-extension/index.html).
    // auto-trailing-slash serves that at both /path and /path/ and redirects to
    // the canonical form, which keeps the URLs in the sitemap and the ones in
    // the Chrome Web Store listing resolving to the same page.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
