{
  "name": "nyuchi-learning",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page for learning.nyuchi.com — points to where the learning content lives now.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --plugin prettier-plugin-svelte --write \"src/**/*.{svelte,ts,js,css}\" \"tests/**/*.ts\"",
    "format:check": "prettier --plugin prettier-plugin-svelte --check \"src/**/*.{svelte,ts,js,css}\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.59.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "3.3.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.43.6",
    "svelte-check": "^4.4.7",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.0.18"
  }
}
