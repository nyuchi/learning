{
  "name": "nyuchi-learning",
  "version": "3.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "learning.nyuchi.com — the Nyuchi Learning surface and the home of the Toddle Enhancement Extension.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "test": "npm run build && vp test run && npm run csp",
    "csp": "node scripts/check-csp.mjs",
    "csp:fix": "node scripts/check-csp.mjs --fix",
    "qa": "npm run build && node scripts/serve-and-qa.mjs",
    "csp:probe": "npm run build && node scripts/serve-and-qa.mjs probe-intercom-csp.mjs",
    "consent:probe": "npm run build && node scripts/serve-and-qa.mjs probe-consent.mjs",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "ci:prepare": "astro sync",
    "ci:check": "astro check && vp fmt --check"
  },
  "dependencies": {
    "@bundu/ui": "^0.5.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.0",
    "axe-core": "^4.12.1",
    "playwright": "^1.63.0",
    "prettier": "3.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite-plus": "^1.0.0"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0"
  },
  "packageManager": "npm@11.12.1"
}
