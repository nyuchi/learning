{
  "name": "nyuchi-learning",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "learning.nyuchi.com — the Nyuchi Learning surface and the home of the Toddle Enhancement Extension.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,js,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "test": "vitest run && npm run build && npm run csp",
    "csp": "node scripts/check-csp.mjs",
    "csp:fix": "node scripts/check-csp.mjs --fix",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@bundu/ui": "^0.1.1",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.0",
    "prettier": "3.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "~4.0.18",
    "wrangler": "^4.142.0"
  }
}
